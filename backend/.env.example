# Base de datos (local Docker / producción gestionada). En producción solo cambiás estas credenciales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=conciertos
DB_USER=conciertos
DB_PASSWORD=conciertos_dev
# Modo SSL para la conexión (requerido por Supabase/Neon: require). Vacío = sin forzar.
DB_SSLMODE=

# Servidor
PORT=5000
HOST=0.0.0.0

# Scraper automático en minutos (360 = cada 6 h). 0 = desactivado.
SCRAPER_INTERVALO_MINUTOS=360

# URL para keep_alive (en producción: https://tu-api.onrender.com). Vacío = desactivado.
# En Render se usa automáticamente RENDER_EXTERNAL_URL si esto queda vacío.
KEEP_ALIVE_URL=